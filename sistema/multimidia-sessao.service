[Unit]
Description=caixinha-multimidia - tela virtual (sway sem monitor) + Sunshine
After=network-online.target caixinha-pipewire-pulse.service caixinha-bt.service
Wants=caixinha-pipewire-pulse.service

[Service]
User=som
EnvironmentFile=/etc/caixinha/ambiente
EnvironmentFile=-/etc/caixinha/sessao.env
Environment=WLR_BACKENDS=headless,libinput
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=LIBSEAT_BACKEND=noop
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_TYPE=wayland
Environment=GDK_BACKEND=wayland
Environment=ADW_DEBUG_COLOR_SCHEME=prefer-dark
Environment=GTK_THEME=Adwaita:dark
RuntimeDirectory=som
RuntimeDirectoryPreserve=yes
WorkingDirectory=/home/som
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/sway -c /etc/caixinha/sway.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
